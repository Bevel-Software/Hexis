# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bevel:bevel@localhost:5432/bevel

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# Git host credential. The KB can live on ANY git server (GitHub, GitLab,
# Bitbucket, Azure DevOps, self-hosted) — change requests are stored in this
# app's DB, not as provider PRs. The token is sent as the HTTP Basic *password*;
# GIT_USERNAME is the Basic username, which differs per host. GIT_TOKEN
# is the provider-neutral name; GITHUB_TOKEN / GH_TOKEN are still accepted.
# GIT_USERNAME per host: GitHub x-access-token (default) · GitLab oauth2 ·
# Bitbucket x-token-auth · Azure DevOps any non-empty value.
GIT_TOKEN=
# GIT_USERNAME=x-access-token

JWT_SECRET=

# The deployment owner. REQUIRED — three jobs rest on it:
#   - always treated as an admin, whatever the sign-in method (password OR
#     SSO), so accounts and roles are administrable before roles.yaml lists it;
#   - written as the initial Admin into the roles.yaml generated when an EMPTY
#     KB repo is seeded (this replaced SEED_ADMIN_EMAILS);
#   - half of the bootstrap password credential below.
ADMIN_EMAIL=
# Password half of the bootstrap credential, checked against the environment at
# login time and never stored. Read once at startup, so changing or unsetting it
# takes effect on the next restart, not at once; database accounts carry on
# either way. Required only while password login is enabled: an SSO-only deployment (LOGIN_PASSWORD=false) should not
# have to hold a shared password the server is configured to reject.
ADMIN_PASSWORD=

# Generic OIDC single sign-on (any spec-compliant provider: Entra, Okta,
# Auth0, Keycloak, Google, …). Enabled when all three are set. Register
# <PUBLIC_BACKEND_URL>/api/auth/oidc/callback as the redirect URI with the
# provider.
#OIDC_ISSUER_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
# Space-separated scopes (default: openid profile email)
#OIDC_SCOPES=
# Login-button label (default: Single sign-on)
#OIDC_PROVIDER_LABEL=

# Reverse-proxy hops in front of this backend (Express `trust proxy`): set to
# the hop count (usually 1) — or an address/CIDR list — so `req.ip` (and the
# per-IP login rate limit) sees the real client instead of the proxy. Leave
# unset when the backend is directly exposed; never set a blanket trust, or
# clients can spoof X-Forwarded-For.
#TRUST_PROXY=1

# Optional dedicated HMAC key for internal (loopback) tool tokens. Leave unset
# to derive a domain-separated key from JWT_SECRET — that already lets sibling
# processes sharing this env (CLIs, replicas) mint tokens the server verifies.
# Set only to rotate the internal surface independently of user sessions.
#INTERNAL_TOKEN_SECRET=

# Tenant slug branded into every credential prefix: external API keys are
# `<TENANT_ID>_…`, internal tokens `<TENANT_ID>-int_…`. Lowercase alphanumeric
# only. Defaults to `bevel`.
# TENANT_ID=bevel

# Password-login toggle (default enabled). Set to false to hide the method on
# the login screen AND reject the /api/auth/login endpoint.
# LOGIN_PASSWORD=true

# Optional SSO allow-list — part of the OIDC configuration above, and only
# meaningful alongside it. SSO auto-provisions: an account appears the first
# time the issuer authenticates someone, with nobody approving it. Against a
# single-tenant issuer the issuer is already the boundary; against a
# multi-tenant one (Google, the Entra `common` endpoint, Auth0 with social
# connections) this is the ONLY boundary. Comma-separated; matches the domain
# exactly or as a subdomain; empty (default) allows any email.
# Deliberately NOT applied to admin-created accounts or password login — those
# can only reach an account somebody already vetted.
# ALLOWED_EMAIL_DOMAINS=example.com

# Knowledge-base repo. The per-branch workspace clones live at
# <workspacesRoot>/<encoded-branch>/<KB_DIR_NAME>. KB_REPO_URL can point at ANY
# https git host — change requests are stored in this app's DB and merged with
# plain git, so no `<owner>/<repo>` slug or provider CLI is needed.
# Leave any of the four KB values blank and an admin is asked for them on the
# setup screen the first time they sign in — where the credentials can be
# tested against the real host before they are saved. Anything set HERE wins
# over anything saved there.
KB_REPO_URL=
KB_DIR_NAME=knowledge-base

# Branch model. DEFAULT_BRANCH is where a user lands without picking a branch and
# the default propose-into target; it should normally also appear in
# PROTECTED_BRANCHES (comma/space-separated list of branch slugs the app refuses
# to commit/push/revert to directly — changes land via change-request approval).
# Runtime only. The frontend is served these over /api/config when it boots,
# rather than having them compiled into its bundle, so one build runs against
# any deployment and renaming a branch does not need a rebuild. DEFAULT_BRANCH
# must be one of PROTECTED_BRANCHES, or the protected-branch guards silently
# stop applying to the branch everyone lands on.
# DEFAULT_BRANCH=main
# PROTECTED_BRANCHES=main

# KB seeding. When the app first loads a KB_REPO_URL that has no branches yet, it
# initialises the repo from the bundled template: it commits the base files to
# every PROTECTED_BRANCHES branch and writes a roles.yaml whose sole Admin is
# ADMIN_EMAIL. (There is no separate SEED_ADMIN_EMAILS — it asked for the same
# answer a second time, and a mismatch between the two produced a deployment
# whose owner could not administer its own KB.)
# KB_TEMPLATE_DIR overrides the template location (defaults to the kb-template/
# shipped inside @bevel-software/platform-core-backend).
# KB_TEMPLATE_DIR=

# Core secrets encryption: 32-byte key (base64 or hex) encrypting the secrets
# vault values + MCP OAuth client secrets/tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENC_KEY=

# Public URLs used to build OAuth redirects + post-login bounces. Defaults
# target local dev (backend :PORT, frontend :5173). Set both in production.
# PUBLIC_BACKEND_URL=http://localhost:3001
# PUBLIC_FRONTEND_URL=http://localhost:5173

# Ontology-session boundary kill-switch (touch tracking only in the core —
# the write block is an enterprise extension). Default true.
# ONTOLOGY_SESSION_BLOCK=true
