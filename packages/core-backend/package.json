{
  "name": "@bevel-software/platform-core-backend",
  "version": "0.3.2",
  "description": "Open-source core backend of the Bevel platform: git-backed knowledge workspace, workflow (branches/change requests/locks/SSE), skills, tools, secrets vault, access control and the remote MCP surface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/modules/database/core-schema.d.ts",
      "default": "./dist/modules/database/core-schema.js"
    },
    "./modules/*": "./dist/modules/*",
    "./shared/*": "./dist/shared/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "kb-template"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run .live.test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@bevel-software/platform-shared": "workspace:*",
    "@mastra/core": "1.35.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@utcp/code-mode": "^1.2.12",
    "@utcp/direct-call": "^1.1.1",
    "@utcp/http": "^1.1.7",
    "@utcp/mcp": "^1.1.3",
    "@utcp/sdk": "^1.1.1",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/qs": "^6.15.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bevel-Software/skill-and-tool-management.git",
    "directory": "packages/core-backend"
  },
  "publishConfig": {
    "access": "public"
  }
}
