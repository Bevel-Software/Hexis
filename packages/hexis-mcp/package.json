{
  "name": "@bevel-software/hexis-mcp",
  "version": "0.13.2",
  "description": "Run a Hexis workspace as a local MCP server: every tool the hosted endpoint serves, plus the local-only tools it cannot reach.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hexis-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!dist/__tests__",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "utcp",
    "hexis",
    "bevel"
  ],
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bevel-software/platform-mcp-core": "workspace:*",
    "adm-zip": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@utcp/cli": "^1.1.1",
    "@utcp/code-mode": "^1.2.13",
    "@utcp/http": "^1.1.11",
    "@utcp/mcp": "^1.1.6",
    "@utcp/sdk": "^1.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.6"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bevel-Software/Hexis.git",
    "directory": "packages/hexis-mcp"
  },
  "publishConfig": {
    "access": "public"
  }
}
