{
  "name": "@bevel-software/platform-mcp-core",
  "version": "0.13.5",
  "description": "The transport-agnostic half of Bevel's MCP surface: UTCP manual registration, tool discovery, MCP listing/dispatch and the code-mode meta-tools. Shared by the hosted proxy and the local stdio server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!dist/__tests__",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@utcp/code-mode": "^1.2.13",
    "@utcp/http": "^1.1.11",
    "@utcp/mcp": "^1.1.6",
    "@utcp/sdk": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.6"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bevel-Software/Hexis.git",
    "directory": "packages/mcp-core"
  },
  "publishConfig": {
    "access": "public"
  }
}
